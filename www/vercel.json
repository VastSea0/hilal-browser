{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/android/latest.apk",
      "destination": "/api/android-latest"
    },
    {
      "source": "/update/:path*",
      "destination": "/api/update?path=:path*"
    },
    {
      "source": "/releases.json",
      "destination": "/api/releases"
    },
    {
      "source": "/api/telemetry",
      "destination": "/api/telemetry"
    },
    {
      "source": "/api/boosts/:id",
      "destination": "/api/boosts?id=:id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
