# GITHUB_TOKEN: optional. Raises the GitHub API rate limit for /releases.json
# and the update endpoint.
GITHUB_TOKEN=""

# HILAL_UPDATE_REPO: GitHub repository used by /releases.json and /update/.../update.xml.
HILAL_UPDATE_REPO="VastSea0/hilal-browser"

# HILAL_UPDATE_CHANNEL: MAR update channel accepted by shipped desktop builds.
HILAL_UPDATE_CHANNEL="hilal-release"

# HILAL_UPDATE_MANIFEST_ASSET: JSON asset uploaded to the GitHub Release next to MAR files.
HILAL_UPDATE_MANIFEST_ASSET="hilal-update-manifest.json"

# Optional fallback if a GitHub Release manifest is not present.
# Prefer the release manifest flow documented in docs/UPDATES.md.
HILAL_UPDATE_MACOS_MAR_URL=""
HILAL_UPDATE_MACOS_MAR_HASH=""
HILAL_UPDATE_MACOS_MAR_SIZE=""
HILAL_UPDATE_LINUX_MAR_URL=""
HILAL_UPDATE_LINUX_MAR_HASH=""
HILAL_UPDATE_LINUX_MAR_SIZE=""
HILAL_UPDATE_WINDOWS_MAR_URL=""
HILAL_UPDATE_WINDOWS_MAR_HASH=""
HILAL_UPDATE_WINDOWS_MAR_SIZE=""
HILAL_UPDATE_BUILD_ID=""
HILAL_UPDATE_DETAILS_URL="https://hilal-browser.vercel.app/#surumler"

# FIREBASE_PROJECT_ID / FIREBASE_API_KEY: Firestore project that stores the
# anonymous Android usage counts sent to /api/telemetry.
FIREBASE_PROJECT_ID=""
FIREBASE_API_KEY=""

# TELEMETRY_ADMIN_SECRET: random secret required to read the telemetry counts.
TELEMETRY_ADMIN_SECRET="your-secure-random-secret-here"

