+// CI writes these prefs at build time; local builds have neither.
+function getHilalChannel() {
+  return Services.prefs.getStringPref("hilal.build.channel", "");
+}
+
+function getHilalVersionLabel() {
+  let label = AppConstants.MOZ_APP_VERSION_DISPLAY;
+  if (getHilalChannel() == "nightly") {
+    label += " Nightly";
+    let commit = Services.prefs.getStringPref("hilal.build.commit", "");
+    if (commit) {
+      label += ` ${commit}`;
+    }
+  }
+  let appVersion = Services.appinfo.version;
+  if (appVersion && appVersion !== AppConstants.MOZ_APP_VERSION_DISPLAY) {
+    label += ` (Firefox ${appVersion} ESR)`;
+  }
+  return label;
+}
