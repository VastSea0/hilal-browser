+}
+
+@keyframes hilal-tab-select-pop {
+  0% {
+    transform: scale(0.92);
+  }
+  100% {
+    transform: scale(1);
+  }
+}
+
+/* Pop/lift animation for selected tab content (icon and label) */
+#sidebar-main[hilal-sidebar] .tabbrowser-tab[selected="true"] .tab-content,
+.tabbrowser-tab[selected="true"] .tab-content {
+  animation: hilal-tab-content-pop 0.32s cubic-bezier(0.34, 1.56, 0.64, 1) forwards !important;
+}
+
+@keyframes hilal-tab-content-pop {
+  0% {
+    transform: translateY(1.5px) scale(0.96);
+  }
+  100% {
