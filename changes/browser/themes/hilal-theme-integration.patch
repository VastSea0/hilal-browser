+  background: rgba(0, 0, 0, 0.08) !important;
+}
+
+/* Hilal Premium Animations & Micro-interactions */
+
+/* Pop/bounce animation for selected tabs */
+#sidebar-main[hilal-sidebar] .tabbrowser-tab[selected="true"] > .tab-stack > .tab-background,
+.tabbrowser-tab[selected="true"] .tab-background {
