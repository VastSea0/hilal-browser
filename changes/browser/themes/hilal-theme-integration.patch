+  border-radius: 99px !important;
+  margin: 0 !important;
+  display: block !important;
+}
+
+#sidebar-main[hilal-sidebar] #pinned-tabs-container[orient="vertical"] .tabbrowser-tab:hover,
+#pinned-tabs-container[orient="vertical"] .tabbrowser-tab:hover {
