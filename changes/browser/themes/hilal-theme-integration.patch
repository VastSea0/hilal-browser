+
+#sidebar-main[hilal-sidebar] #pinned-tabs-container[orient="vertical"] .tabbrowser-tab[usercontextid] .tab-context-line,
+#pinned-tabs-container[orient="vertical"] .tabbrowser-tab[usercontextid] .tab-context-line {
