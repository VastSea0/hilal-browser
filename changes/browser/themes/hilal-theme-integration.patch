+  }
+}
+
+/* Press/active physical feedback on tabs */
+#sidebar-main[hilal-sidebar] .tabbrowser-tab:active,
+.tabbrowser-tab:active {
+  transform: scale(0.96) !important;
+  transition: transform 0.08s ease-out !important;
+}
