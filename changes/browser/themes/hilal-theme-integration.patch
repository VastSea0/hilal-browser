+/* Hide label, close button, and pin badge completely in pinned grid */
+#sidebar-main[hilal-sidebar] #pinned-tabs-container[orient="vertical"] .tab-label-container,
+#sidebar-main[hilal-sidebar] #pinned-tabs-container[orient="vertical"] .tab-label,
