export HILAL_DISABLE_UPDATER=1

# Flatpak builds use the SDK's bundled toolchain; skip bootstrap toolchain tasks.
ac_add_options --enable-bootstrap=no-update

. "$topsrcdir/../mozconfigs/base"

# RLBox needs Mozilla's wasi sysroot, which the offline Flatpak build cannot
# download.
ac_add_options --without-wasm-sandboxed-libraries
