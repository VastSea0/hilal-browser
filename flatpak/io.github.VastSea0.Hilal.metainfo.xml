<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.VastSea0.Hilal</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MPL-2.0 AND GPL-3.0-only</project_license>

  <name>Hilal</name>
  <summary>Privacy-first web browser built on Firefox</summary>
  <developer id="io.github.VastSea0">
    <name>Hilal</name>
  </developer>

  <launchable type="desktop-id">io.github.VastSea0.Hilal.desktop</launchable>
  <provides>
    <binary>hilal</binary>
  </provides>

  <description>
    <p>Hilal is a free and open source web browser built on Firefox ESR. It keeps Firefox's engine, extensions and security updates, and adds a calmer, more customizable interface.</p>
    <ul>
      <li>Vertical tabs in a sidebar, with workspaces to keep work, study and personal browsing apart.</li>
      <li>A Material 3 Expressive design that can take its colors from the website you are on.</li>
      <li>Boosts: recolor any website, change its fonts, hide parts of it or add your own CSS.</li>
      <li>Three protection levels, Balanced, Strict and Maximum, with uBlock Origin built in.</li>
      <li>Safe Browsing protection against phishing and malware.</li>
    </ul>
  </description>

  <releases>
    <release version="0.4.0-alpha.3" date="2026-11-11" type="development"/>
    <release version="0.4.0-alpha.2" date="2026-11-06" type="development"/>
    <release version="0.4.0-alpha.1" date="2026-11-01" type="development"/>
    <release version="0.3.0-alpha.6" date="2026-06-21" type="development"/>
  </releases>

  <content_rating type="oars-1.1"/>

  <url type="homepage">https://hilal-browser.vercel.app/</url>
  <url type="bugtracker">https://github.com/VastSea0/hilal-browser/issues</url>
  <url type="vcs-browser">https://github.com/VastSea0/hilal-browser</url>
  <url type="translate">https://github.com/VastSea0/hilal-browser</url>

  <keywords>
